rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App "Avances de montaje": todas las colecciones montaje_* (parques, turbinas, alarmas, respaldos)
    match /{col}/{rest=**} {
      allow read, write: if request.auth != null && col.matches('montaje_.*');
    }
  }
}
