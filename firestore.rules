rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // App de montaje: cualquier usuario autenticado (anónimo incluido) lee y escribe.
    // Para producción conviene pasar a usuarios con email y limitar la escritura.
    match /montaje_parque/{docId} {
      allow read, write: if request.auth != null;
    }
    match /montaje_turbinas/{docId} {
      allow read, write: if request.auth != null;
    }
    match /montaje_alarmas/{docId} {
      allow read, write: if request.auth != null;
    }

    // Todo lo demás queda cerrado para esta app (no toca otras colecciones del proyecto).
  }
}
